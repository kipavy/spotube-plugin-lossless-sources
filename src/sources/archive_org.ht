import "module:std" as std

var HttpClient = std.HttpClient
var HttpResponse = std.HttpResponse

/// Characters kept when comparing titles. Anything else is dropped, so
/// "Don't Want You No More" and "dont want you no more.flac" compare equal.
var KEEP = "abcdefghijklmnopqrstuvwxyz0123456789 "

/// Leading track numbers to strip off a file name, and what may separate them
/// from the title: "01. Cars And Girls", "03 - Nero The Zero".
/// Words that mark a file as somebody else's performance rather than the
/// recording asked for. Matched whole, so "Discovery" is not read as a cover.
///
/// "live" is deliberately absent. The Archive is largely live recordings --
/// that is most of what it uniquely has -- so excluding them by name would
/// empty it. A live take that runs as long as the track asked for is kept;
/// the length check is what tells the others apart.
var FOREIGN_MARKERS = [
  "cover", "covers", "karaoke", "tribute", "remix", "remixes",
  "instrumental", "acapella", "nightcore", "mashup",
]

var DIGITS = "0123456789"
var NUMBER_SEPARATORS = ". -_)"

/// How far a file's length may stray from the track's: a tenth of it, and
/// never less than this many milliseconds, so rips with a little silence at
/// either end still match a short track.
var LENGTH_SLACK_MS = 15000

/// How many search results to open per strategy. Each one costs a metadata
/// request, and scanning stops at the first item that holds the track.
var MAX_ITEMS = 6

/// The Internet Archive, which needs no account, no key and no instance.
///
/// Coverage is uneven rather than absent: live recordings and public-domain
/// material are here in depth, and a fair number of studio albums have been
/// uploaded by users too -- those can disappear again without notice. It earns
/// its place by being the one source that cannot be blocked: when every proxy
/// is down, this still answers, and the FLAC it serves is a direct file URL.
class ArchiveOrgSource {
  var client: HttpClient

  get id -> String => "archive"

  get supportedPresets -> List {
    return [
      {
        type: "lossless",
        name: "flac",
        qualities: [
          { bitDepth: 16, sampleRate: 44100 },
        ],
      }.toJson(),
    ]
  }

  construct (this.client)

  /// Lowercases and strips punctuation so titles can be compared loosely.
  fun simplify(value) -> String {
    if (value == null) return ""
    var lower = value.toString().toLowerCase()
    var kept = ""
    for (var index = 0; index < lower.length; index = index + 1) {
      var character = lower.substring(index, index + 1)
      if (KEEP.contains(character)) kept = kept + character
    }
    return kept.trim()
  }

  /// The song part of a file path: the leaf, without its extension or its
  /// track number.
  ///
  /// Uploads are commonly one folder per single, and archive.org often sets a
  /// file's `title` to its whole path. Comparing that path meant every file
  /// inside a folder named after the track looked like the track -- an upload
  /// of "Cars And Girls [+]" matched Vendetta and Nero The Zero too -- and the
  /// match that won carried a path as its title, which nothing can search for.
  fun leaf(value) -> String {
    if (value == null) return ""

    var parts = value.toString().split("/")
    var last = parts[parts.length - 1]

    if (last.toLowerCase().endsWith(".flac")) {
      last = last.substring(0, last.length - 5)
    }

    var digits = 0
    var counting = true
    for (var index = 0; index < last.length; index = index + 1) {
      if (counting && DIGITS.contains(last.substring(index, index + 1))) {
        digits = digits + 1
      } else {
        counting = false
      }
    }

    // Only a number that something separates from the name is a track number,
    // so a title that genuinely opens with a figure is left alone.
    if (digits > 0 && digits < last.length) {
      var cursor = digits
      var skipping = true
      for (var index = digits; index < last.length; index = index + 1) {
        if (skipping &&
            NUMBER_SEPARATORS.contains(last.substring(index, index + 1))) {
          cursor = cursor + 1
        } else {
          skipping = false
        }
      }
      if (cursor > digits) { last = last.substring(cursor) }
    }

    return last.trim()
  }

  /// Whether a name announces itself as a different performance.
  ///
  /// Compared word by word, and only when the track being asked for does not
  /// carry the same word -- a request for a remix should still find one.
  fun foreign(text: String, wanted: String) -> bool {
    var words = text.split(" ")
    for (var marker in FOREIGN_MARKERS) {
      var present = false
      for (var word in words) {
        if (word == marker) present = true
      }
      if (present && !wanted.contains(marker)) return true
    }
    return false
  }

  /// Quotes are the only thing that can break the query syntax.
  fun escape(value) -> String {
    if (value == null) return ""
    return value.toString().replaceAll("\"", "")
  }

  /// Lowercases and turns punctuation into spaces, single-spaced and padded,
  /// so a name can be looked for as whole words: "Europe-The Final Countdown"
  /// becomes " europe the final countdown ", not "europethe".
  fun words(value) -> String {
    if (value == null) return " "
    var lower = value.toString().toLowerCase()
    var spaced = " "
    for (var index = 0; index < lower.length; index = index + 1) {
      var character = lower.substring(index, index + 1)
      if (!KEEP.contains(character)) character = " "
      if (character != " " || !spaced.endsWith(" ")) spaced = spaced + character
    }
    return spaced.endsWith(" ") ? spaced : spaced + " "
  }

  /// Every artist the track credits, as padded words.
  fun artistsOf(track: Map) -> List {
    var names = []
    if (track["artists"] == null) return names
    for (var artist in track["artists"]) {
      var name = artist == null ? null : artist["name"]
      var spaced = words(name ?? artist)
      if (spaced != " ") names.add(spaced)
    }
    return names
  }

  /// Whether an item is credited to one of the track's artists.
  ///
  /// The free-text search matches anything that mentions the artist, setlists
  /// included: Europe's "The Final Countdown" found another band's bar gig
  /// whose description read "[Europe cover, impromptu]", and its file, named
  /// after the song alone, passed every other check. The artist has to appear
  /// in the item's creator or title, or in the file itself -- the last two
  /// because uploads that left `creator` as the uploader still name the
  /// artist there. Matched as whole words, so "Yes" is not found in
  /// "Yesterday".
  fun credited(texts: List, artists: List) -> bool {
    // Nothing to check against, so nothing can be ruled out.
    if (artists.isEmpty) return true
    for (var text in texts) {
      var spaced = words(text)
      for (var artist in artists) {
        if (spaced.contains(artist)) return true
      }
    }
    return false
  }

  /// Whether a file runs about as long as the track asked for.
  ///
  /// Soft Cell's "Tainted Love" is 2:33 on the album; the Archive's best hit
  /// for it was a club compilation's 8:55 extended mix, credited to Soft Cell
  /// under the same name, so nothing else could tell it from the record.
  /// Either length missing means there is nothing to compare, so it passes.
  fun sameLength(length, track: Map) -> bool {
    var wanted = track["durationMs"] ?? 0
    var actual = toMilliseconds(length)
    if (wanted <= 0 || actual <= 0) return true

    var gap = actual - wanted
    if (gap < 0) gap = -gap

    var slack = wanted / 10
    if (slack < LENGTH_SLACK_MS) slack = LENGTH_SLACK_MS
    return gap <= slack
  }

  fun artistOf(track: Map) -> String {
    if (track["artists"] == null || track["artists"].isEmpty) return ""
    var first = track["artists"][0]
    // Not `is Map`: a Hetu struct is not a Map, and the failed test would put
    // the whole object into the query.
    var name = first == null ? null : first["name"]
    return escape(name ?? first)
  }

  /// Primary search: the performer.
  ///
  /// The Archive indexes items -- whole albums and concerts -- so searching by
  /// track title looks for an item called "Scarlet Begonias" and finds
  /// nothing. Individual songs exist only inside an item's file list, which is
  /// why the match is made by opening items and reading their files.
  fun creatorQuery(track: Map) -> String {
    var artist = artistOf(track)
    if (artist == "") return ""
    return "creator:(\"${artist}\") AND mediatype:(audio) AND format:(Flac)"
  }

  /// Fallback search: free text over everything the item says about itself.
  ///
  /// Uploads are inconsistent -- an album can name the artist in its title, or
  /// its description, and leave `creator` as the person who uploaded it. This
  /// catches those; it is second because it also matches far more noise.
  fun textQuery(track: Map) -> String {
    var artist = artistOf(track)
    var name = escape(track["name"] ?? "")
    if (artist == "" && name == "") return ""

    var terms = artist == "" ? "\"${name}\"" : "\"${artist}\" AND \"${name}\""
    return "${terms} AND mediatype:(audio) AND format:(Flac)"
  }

  /// Walks the search hits one item at a time, opening each item's file list
  /// until a FLAC whose title matches the track turns up.
  fun inspect(index: int, identifiers: List, track: Map, base: String) -> Future {
    if (index >= identifiers.length || index >= MAX_ITEMS) return Future.value([])

    var identifier = identifiers[index]

    return client.get_req("${base}/metadata/${identifier}").then((res) {
      if (res.statusCode != 200 || res.data == null) {
        return inspect(index + 1, identifiers, track, base)
      }

      var files = res.data["files"]
      if (files == null || files.isEmpty) {
        return inspect(index + 1, identifiers, track, base)
      }

      var wanted = simplify(track["name"] ?? "")
      var metadata = res.data["metadata"] ?? {}
      var creator = metadata["creator"] ?? ""
      var artists = artistsOf(track)
      var found = []

      for (var file in files) {
        var name = file["name"] ?? ""
        if (!name.toLowerCase().endsWith(".flac")) continue

        // Both sides are reduced to the leaf first: a title set to the full
        // path would otherwise carry the folder's name into every comparison.
        var label = leaf(file["title"] ?? name)
        var fallback = leaf(name)
        var simplified = simplify(label)
        var simplifiedName = simplify(fallback)
        if (wanted != "" && !simplified.contains(wanted) && !simplifiedName.contains(wanted)) continue

        // Carrying the track's name is not enough: an upload of somebody
        // else's cover carries it too, and the router has no second chance
        // once a source has answered.
        if (wanted != "" && (foreign(simplified, wanted) || foreign(simplifiedName, wanted))) continue

        // Nor is carrying the name and being found by the artist: the free
        // text matches a setlist naming whoever wrote the song.
        if (!credited([creator, metadata["title"], file["title"], name], artists)) continue

        // Nor is being the right artist's: a club mix, a live take or an
        // extended version carries the same name and the same credit.
        if (!sameLength(file["length"], track)) continue

        found.add({
          "id": "archive:${identifier}|${name}",
          "title": label,
          "artists": [creator == "" ? "Internet Archive" : creator],
          "duration": toMilliseconds(file["length"]),
          "thumbnail": "${base}/services/img/${identifier}",
          "externalUri": "${base}/details/${identifier}",
          "isrc": "",
          "album": metadata["title"] ?? "",
        }.toJson())
      }

      if (found.isEmpty) return inspect(index + 1, identifiers, track, base)
      return found
    })
  }

  /// Archive lengths come as either seconds ("312.5") or "mm:ss".
  fun toMilliseconds(length) -> int {
    if (length == null) return 0
    var text = length.toString()
    if (text == "") return 0

    if (text.contains(":")) {
      var parts = text.split(":")
      var minutes = readNumber(parts[0])
      var seconds = parts.length > 1 ? readNumber(parts[1]) : 0
      return (minutes * 60 + seconds) * 1000
    }

    return readNumber(text) * 1000
  }

  /// int.parse throws on anything unexpected and Hetu has no try/catch, so the
  /// digits are checked first and the fractional part dropped.
  fun readNumber(text) -> int {
    if (text == null) return 0
    var whole = text.toString().trim()
    if (whole.contains(".")) whole = whole.split(".")[0]
    if (whole == "") return 0

    for (var index = 0; index < whole.length; index = index + 1) {
      if (!"0123456789".contains(whole.substring(index, index + 1))) return 0
    }
    return int.parse(whole)
  }

  /// Runs one search and returns the item identifiers it found.
  fun searchItems(base: String, query: String) -> Future {
    if (query == "") return Future.value([])

    return client.get_req(
      "${base}/advancedsearch.php",
      queryParameters: {
        "q": query,
        "fl[]": "identifier",
        // Most-downloaded first: a wanted track is likeliest to be in the
        // items people actually listen to.
        "sort[]": "downloads desc",
        "rows": MAX_ITEMS,
        "output": "json",
      }.toJson(),
    ).then((res) {
      if (res.statusCode != 200 || res.data == null) return []

      var response = res.data["response"]
      if (response == null) return []

      var docs = response["docs"]
      if (docs == null || docs.isEmpty) return []

      var identifiers = []
      for (var doc in docs) {
        if (doc["identifier"] != null) identifiers.add(doc["identifier"])
      }
      return identifiers
    })
  }

  /// Tries the performer search first and falls back to free text, because an
  /// upload that leaves `creator` as the uploader is only findable that way.
  fun matches(track: Map, query: String, bases: List) -> Future {
    if (bases == null || bases.isEmpty) return Future.value([])
    if (track == null) return Future.value([])

    var base = bases[0]

    return searchItems(base, creatorQuery(track)).then((identifiers) {
      return inspect(0, identifiers, track, base).then((found) {
        if (found != null && found.isNotEmpty) return found

        return searchItems(base, textQuery(track)).then((fallback) {
          return inspect(0, fallback, track, base)
        })
      })
    })
  }

  fun streams(match: Map, reference: String, bases: List) -> Future {
    if (bases == null || bases.isEmpty) return Future.value([])
    if (reference == null || !reference.contains("|")) return Future.value([])

    var parts = reference.split("|")
    var identifier = parts[0]
    var file = parts[1].replaceAll(" ", "%20")

    // A direct file URL, so there is nothing to resolve and nothing to expire.
    return Future.value([
      {
        "url": "${bases[0]}/download/${identifier}/${file}",
        "container": "flac",
        "type": "lossless",
        "codec": "flac",
        "bitrate": 1411000,
        "sampleRate": 44100,
        "bitDepth": 16,
      }.toJson(),
    ])
  }
}

export { ArchiveOrgSource }
