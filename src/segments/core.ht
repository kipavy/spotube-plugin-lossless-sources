import "module:std" as std

var HttpClient = std.HttpClient
// Required for the `.then` callback below to resolve, even though it is never
// referenced by name. See the same declaration in audio_source.ht.
var HttpResponse = std.HttpResponse
var RequestOptions = std.RequestOptions

class CorePlugin {
  var client: HttpClient

  construct (this.client)

  /// Checks for updates to the plugin.
  /// [currentConfig] is just plugin.json's file content.
  ///
  /// If there's an update available, it will return a map of:
  /// - [downloadUrl] -> direct download url to the new plugin.smplug file.
  /// - [version] of the new plugin.
  /// - [changelog] Optionally, a changelog for the update (markdown supported).
  ///
  /// If no update is available, it will return null.
  fun checkUpdate(currentConfig: Map) -> Future {
    var versionParts = currentConfig["version"].split(".")
    var major = int.parse(versionParts[0])
    var minor = int.parse(versionParts[1])
    var patch = int.parse(versionParts[2])

    return client.get_req(
      "https://api.github.com/repos/kipavy/spotube-plugin-lossless-sources/releases/latest",
      options: RequestOptions(
        headers: {
          "Accept": "application/vnd.github.v3+json"
        }.toJson()
      ),
    ).then((res) {
      if (res.statusCode != 200 || res.data == null) return null

      var data = res.data
      var latestVersion = data["tag_name"].split(".")

      if (latestVersion.length < 3) {
        throw "Invalid version format from GitHub API. Expected format: <major>.<minor>.<patch>. Got: ${data["tag_name"]}"
      }

      var latestMajor = int.parse(latestVersion[0])
      var latestMinor = int.parse(latestVersion[1])
      var latestPatch = int.parse(latestVersion[2])

      var isUpdateAvailable = latestMajor > major ||
        (latestMajor == major && latestMinor > minor) ||
        (latestMajor == major && latestMinor == minor && latestPatch > patch)

      if (!isUpdateAvailable) return null

      var downloadUrl = data["assets"].firstWhere(
        (asset) => asset["name"] == "plugin.smplug",
        orElse: () => null
      )?["browser_download_url"]

      if (downloadUrl == null) {
        throw "No download URL found for the plugin update"
      }

      var changelog = data["body"] ?? "No changelog available"

      return {
        "downloadUrl": downloadUrl,
        "version": data["tag_name"],
        "changelog": changelog
      }.toJson()
    })
  }

  /// Returns the support information for the plugin in Markdown or plain text.
  get support -> string {
    return "
# Lossless Sources

Each track is routed to whichever public source can actually play it:

- **hifi-api instances** — Tidal, the full mainstream catalogue, matched by
  ISRC so remasters and live versions are not confused with each other.
- **the Internet Archive** — live recordings, public-domain material and
  studio albums other people have uploaded. No account, nothing to block, but
  coverage is a lottery: a track is there only if someone put it there.
- **YouTube** — everything else. Not lossless (Opus or AAC), so it is tried
  last, after both lossless sources have come up empty.

## If playback stops working

Instances proxy Tidal with their own account, and an instance answering
`Upstream API error` or `Token refresh failed` has had that account blocked.
As of September 2026 every public one is in that state, so a track plays
losslessly only when the Archive happens to hold it — otherwise it falls back
to YouTube, which is lossy but almost always has it.

There is nothing to configure. The source list is a file in the repository
that an hourly probe keeps current, so a source that comes back reaches you
within the hour without an update.

Report a broken source, or suggest a working one, at
[github.com/kipavy/spotube-plugin-lossless-sources/issues](https://github.com/kipavy/spotube-plugin-lossless-sources/issues).

## Quality

Streams are served at whatever tier the instance's Tidal account allows. A
lower-tier account returns AAC 320 even when lossless is requested.
"
  }
}

export { CorePlugin }
