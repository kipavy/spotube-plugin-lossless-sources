import "module:std" as std

import { SourceStore } from './sources.ht'
import { HifiApiSource } from '../sources/hifi_api.ht'
import { MonochromeSource } from '../sources/monochrome.ht'
import { YouTubeSource } from '../sources/youtube.ht'

var HttpClient = std.HttpClient
// Never referenced directly, but the runtime resolves the type of every
// `.then` callback parameter in this scope.
var HttpResponse = std.HttpResponse

/// Match ids are `<source id>:<reference>`, so a match can be handed back to
/// the source that produced it when Spotube asks for its streams.
var ID_SEPARATOR = ":"

/// Ids written before the plugin had more than one source. Spotube keeps
/// matches it has already resolved, so those still arrive here.
var LEGACY_SOURCE = "hifi-api"

/// How far a match's length may stray from the track's before it counts as
/// another version: 15 seconds, or a tenth of the track when that is more.
var LENGTH_SLACK_MS = 15000

/// Routes a track to whichever source can actually play it.
///
/// Sources are tried in the order the published list gives them and the first
/// one with a match wins, so the list is also the preference order: the
/// lossless sources that carry the mainstream catalogue first, YouTube last as
/// the lossy one that almost always has the track.
class AudioSourceEndpoint {
  var client: HttpClient
  var store: SourceStore

  var hifiApi: HifiApiSource
  var monochrome: MonochromeSource
  var youtube: YouTubeSource

  construct (this.client, this.store) {
    hifiApi = HifiApiSource(client)
    monochrome = MonochromeSource(client)
    youtube = YouTubeSource()
  }

  fun sourceFor(type) {
    if (type == "hifi-api") return hifiApi
    if (type == "monochrome") return monochrome
    if (type == "youtube") return youtube
    // An unknown type in the published list is skipped rather than fatal, so
    // a new source can be listed before every installed plugin understands it.
    return null
  }

  /// Every container any source can deliver.
  ///
  /// Order matters. Spotube selects a preset by index, then keeps only the
  /// streams whose container equals that preset's name and reduces over them,
  /// which throws on an empty list rather than falling back. mp4 stays first
  /// because both the hifi-api instances and YouTube return it, so the default
  /// selection always resolves to something.
  get supportedPresets -> List {
    return [
      {
        type: "lossy",
        name: "mp4",
        qualities: [
          { bitrate: 320000 },
          { bitrate: 256000 },
          { bitrate: 128000 },
          { bitrate: 96000 },
        ],
      }.toJson(),
      {
        type: "lossless",
        name: "flac",
        qualities: [
          { bitDepth: 24, sampleRate: 96000 },
          { bitDepth: 16, sampleRate: 44100 },
        ],
      }.toJson(),
      {
        type: "lossy",
        name: "webm",
        qualities: [
          { bitrate: 256000 },
          { bitrate: 128000 },
          { bitrate: 96000 },
        ],
      }.toJson(),
    ]
  }

  /// Collapses the flat source list into one group per type, keeping the
  /// order the list gave: [{ type, bases: [...] }].
  fun grouped(sources: List) -> List {
    var groups = []
    for (var item in sources) {
      var existing = null
      for (var group in groups) {
        if (group["type"] == item["type"]) existing = group
      }
      if (existing == null) {
        groups.add({ "type": item["type"], "bases": [item["base"]] })
      } else {
        existing["bases"].add(item["base"])
      }
    }
    return groups
  }

  /// Reads an artist's name whether it arrives as a map, a struct or a bare
  /// string. `is Map` cannot be used: a Hetu struct is not a Map, so the test
  /// silently fails and the whole object ends up stringified into the query.
  fun artistName(artist) -> String {
    if (artist == null) return ""
    var name = artist["name"]
    if (name != null) return name.toString()
    return artist.toString()
  }

  fun searchText(track: Map) -> String {
    var name = track["name"] ?? ""

    var names = []
    if (track["artists"] != null) {
      for (var artist in track["artists"]) {
        var artistName = artistName(artist)
        if (artistName != "") names.add(artistName)
      }
    }

    if (names.isEmpty) return name
    return "${name} ${names.join(", ")}"
  }

  /// Asks each source in turn and stops at the first with results.
  fun askFrom(index: int, groups: List, track: Map, query: String) -> Future {
    if (index >= groups.length) return Future.value([])

    var group = groups[index]
    var source = sourceFor(group["type"])
    if (source == null) return askFrom(index + 1, groups, track, query)

    return source.matches(track, query, group["bases"]).then((found) {
      var fitting = byLength(found, track, group["type"] == "youtube")
      if (fitting.isNotEmpty) return fitting
      return askFrom(index + 1, groups, track, query)
    })
  }

  /// Whether a match runs about as long as the track asked for.
  ///
  /// Every source returns other versions under the same name and the same
  /// credit -- Soft Cell's "Tainted Love" is 2:33 on the album and 8:55 as the
  /// club mix -- and only the length tells them apart. A match carrying the
  /// track's own ISRC is the recording, and catalogues disagree on its length
  /// by a second or two, so it fails only when it is off by a factor of two,
  /// which means a catalogue error. Either length missing passes: there is
  /// nothing to compare.
  fun sameLength(match: Map, wanted: int, isrc: String) -> bool {
    var actual = match["duration"] ?? 0
    if (wanted <= 0 || actual <= 0) return true

    var candidate = match["isrc"]
    if (isrc != "" && candidate != null && candidate.toString().toUpperCase() == isrc) {
      return actual < wanted * 2 && actual * 2 > wanted
    }

    var gap = actual - wanted
    if (gap < 0) gap = -gap

    var slack = wanted / 10
    if (slack < LENGTH_SLACK_MS) slack = LENGTH_SLACK_MS
    return gap <= slack
  }

  /// Keeps the matches of the right length, in the order the source ranked
  /// them.
  ///
  /// A lossless source that only has the wrong version is skipped, so the
  /// router moves on. YouTube is the exception: it is the last resort, and its
  /// title search often finds the official video, intro and outro included,
  /// so a wrong length there only moves a match down rather than dropping it
  /// -- a slightly long video beats silence.
  fun byLength(found, track: Map, lastResort: bool) -> List {
    if (found == null || found.isEmpty) return []

    var wanted = track["durationMs"] ?? 0
    var isrc = (track["isrc"] ?? "").toString().toUpperCase()

    var kept = []
    var rest = []
    for (var match in found) {
      if (sameLength(match, wanted, isrc)) {
        kept.add(match)
      } else {
        rest.add(match)
      }
    }

    if (lastResort) {
      for (var match in rest) { kept.add(match) }
    }
    return kept
  }

  /// Find matching audio sources for a given track. The first match is
  /// considered the best match.
  /// @param track - Map<SpotubeTrackObject>
  /// @returns Future<List<SpotubeAudioSourceMatchObject>>
  fun matches(track: Map) -> List {
    if (track == null) return Future.value([])

    var name = track["name"] ?? ""
    if (name == "") return Future.value([])

    var query = searchText(track)

    return store.resolve().then((sources) {
      return askFrom(0, grouped(sources), track, query)
    })
  }

  /// For the given match, return all available streams.
  /// @param match - Map<SpotubeAudioSourceMatchObject>
  /// @returns Future<List<SpotubeAudioSourceStreamObject>>
  fun streams(match: Map) -> List {
    if (match == null) return Future.value([])

    var id = match["id"]
    if (id == null || id == "") return Future.value([])

    var text = id.toString()
    var cut = text.indexOf(ID_SEPARATOR)

    // No prefix means a match resolved by an older version, which could only
    // have come from hifi-api.
    var type = cut > 0 ? text.substring(0, cut) : LEGACY_SOURCE
    var reference = cut > 0 ? text.substring(cut + 1) : text

    // A match from a source this version no longer has -- Spotube keeps the
    // "archive:" matches resolved before the Internet Archive was dropped --
    // is played from YouTube by its title and artists, rather than not at all:
    // Spotube asks for the streams of the match it holds and never re-matches.
    var source = sourceFor(type)
    if (source == null) {
      return upgrade(match, type, []).then((have) {
        return topUp(match, type, have)
      })
    }

    return store.basesFor(type).then((bases) {
      return source.streams(match, reference, bases).then((found) {
        return upgrade(match, type, found).then((have) {
          return topUp(match, type, have)
        })
      })
    })
  }

  /// Puts lossless in front of a match that cannot offer it.
  ///
  /// Spotube saves the match it picked for every track it has played, and
  /// from then on only asks for that match's streams -- it never matches the
  /// track again. Everything played while the Tidal instances were blocked is
  /// therefore pinned to a blocked instance or a YouTube video, and with the
  /// flac preset selected Spotube keeps no stream at all and skips the track.
  /// Looking the same recording up on the other lossless sources here is what
  /// lets an existing library play lossless without clearing anything.
  ///
  /// Spotube does not save the result, so this lookup runs on every play of
  /// such a track. Only matches with no flac pay for it.
  fun upgrade(match: Map, type: String, found: List) -> Future {
    var have = found == null ? [] : found
    for (var stream in have) {
      if (stream["container"] == "flac") return Future.value(have)
    }

    var wanted = recordingOf(match, type)
    if (wanted == null) return Future.value(have)

    return store.resolve().then((sources) {
      // The match's own source already failed to produce lossless, and
      // YouTube cannot.
      var lossless = []
      for (var group in grouped(sources)) {
        if (group["type"] != "youtube" && group["type"] != type) lossless.add(group)
      }

      return losslessFrom(0, lossless, wanted["track"], wanted["query"]).then((better) {
        if (better == null || better.isEmpty) return have

        var all = []
        for (var stream in better) { all.add(stream) }
        for (var stream in have) { all.add(stream) }
        return all
      })
    })
  }

  /// The flac streams of the first lossless source that has the recording.
  fun losslessFrom(index: int, groups: List, track: Map, query: String) -> Future {
    if (index >= groups.length) return Future.value([])

    var group = groups[index]
    var source = sourceFor(group["type"])
    if (source == null) return losslessFrom(index + 1, groups, track, query)

    return source.matches(track, query, group["bases"]).then((found) {
      var fitting = byLength(found, track, false)
      if (fitting.isEmpty) return losslessFrom(index + 1, groups, track, query)

      var best = fitting[0]
      var text = best["id"].toString()
      var reference = text.substring(text.indexOf(ID_SEPARATOR) + 1)

      return source.streams(best, reference, group["bases"]).then((streams) {
        var flac = []
        if (streams != null) {
          for (var stream in streams) {
            if (stream["container"] == "flac") flac.add(stream)
          }
        }
        if (flac.isEmpty) return losslessFrom(index + 1, groups, track, query)
        return flac
      })
    })
  }

  /// Rebuilds the track a saved match stands for, so it can be searched for.
  ///
  /// A catalogue match carries the real title, artists and ISRC. A YouTube
  /// match carries the video's title and the channel, so "Daft Punk - One
  /// More Time (Official Video)" is read as artist and title, without the
  /// bracketed part.
  fun recordingOf(match: Map, type: String) {
    var title = (match["title"] ?? "").toString()
    if (title == "") return null

    var names = []
    if (match["artists"] != null) {
      for (var artist in match["artists"]) {
        var name = artist == null ? "" : artist.toString()
        if (name != "") { names.add(name) }
      }
    }

    if (type == "youtube") {
      var dash = title.indexOf(" - ")
      if (dash > 0) {
        names = [title.substring(0, dash).trim()]
        title = title.substring(dash + 3)
      }
      title = withoutBrackets(title)
      if (title == "") return null
    }

    var artists = []
    for (var name in names) {
      artists.add({ "name": name })
    }

    var track = {
      "name": title,
      "artists": artists,
      "isrc": (match["isrc"] ?? "").toString(),
      "durationMs": match["duration"] ?? 0,
    }.toJson()

    var query = names.isEmpty ? title : "${title} ${names.join(", ")}"
    return { "track": track, "query": query }
  }

  /// Drops every (...) and [...] part: "(Official Video)", "[HD]".
  fun withoutBrackets(text: String) -> String {
    var kept = ""
    var depth = 0
    for (var index = 0; index < text.length; index = index + 1) {
      var character = text.substring(index, index + 1)
      if (character == "(" || character == "[") {
        depth = depth + 1
      } else if (character == ")" || character == "]") {
        if (depth > 0) depth = depth - 1
      } else if (depth == 0) {
        kept = kept + character
      }
    }
    return kept.trim()
  }

  /// Adds a lossy container to a match that can only offer lossless.
  ///
  /// Spotube keeps only the streams whose container equals the preset the
  /// listener picked, then reduces over them -- and reduce throws on an empty
  /// list rather than falling back. Monochrome serves nothing but flac, so a
  /// flac-only match plays nothing at all for anyone left on the default mp4
  /// preset, and Spotube never retries the other matches: it asks for the
  /// streams of the first one and stops.
  ///
  /// Looking the same recording up on YouTube and appending its streams keeps
  /// every preset playable. The flac stays first, so lossless still wins the
  /// moment it is the preset asked for.
  fun topUp(match: Map, type: String, found: List) -> Future {
    // A blocked instance answers the catalogue but not the stream endpoint,
    // so this arrives empty far more often than it arrives with a flac.
    var have = found == null ? [] : found

    // YouTube is the source being topped up with; it cannot top up itself.
    if (type == "youtube") return Future.value(have)

    for (var stream in have) {
      if (stream["container"] != "flac") return Future.value(have)
    }

    // A match object carries its artists as plain strings, not the maps a
    // track arrives with, so the query is built here rather than through
    // searchText.
    var title = (match["title"] ?? "").toString()
    if (title == "") return Future.value(have)

    var names = []
    if (match["artists"] != null) {
      for (var artist in match["artists"]) {
        var name = artist == null ? "" : artist.toString()
        if (name != "") { names.add(name) }
      }
    }

    var query = names.isEmpty ? title : "${title} ${names.join(", ")}"

    var wanted = {
      "name": title,
      // Deliberately blank: the ISRC names the catalogue recording, and this
      // is a lookup for whatever upload carries the same performance.
      "isrc": "",
    }.toJson()

    return youtube.matches(wanted, query, []).then((alternatives) {
      if (alternatives == null || alternatives.isEmpty) return have

      var alternative = alternatives[0]
      var text = alternative["id"].toString()
      var cut = text.indexOf(ID_SEPARATOR)
      var reference = cut > 0 ? text.substring(cut + 1) : text

      return youtube.streams(alternative, reference, []).then((extra) {
        if (extra == null || extra.isEmpty) return have

        var all = []
        for (var stream in have) { all.add(stream) }
        for (var stream in extra) { all.add(stream) }
        return all
      })
    })
  }
}

export { AudioSourceEndpoint }
