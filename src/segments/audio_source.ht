import "module:std" as std

import { SourceStore } from './sources.ht'
import { HifiApiSource } from '../sources/hifi_api.ht'
import { ArchiveOrgSource } from '../sources/archive_org.ht'

var HttpClient = std.HttpClient
// Never referenced directly, but the runtime resolves the type of every
// `.then` callback parameter in this scope.
var HttpResponse = std.HttpResponse

/// Match ids are `<source id>:<reference>`, so a match can be handed back to
/// the source that produced it when Spotube asks for its streams.
var ID_SEPARATOR = ":"

/// Ids written before the plugin had more than one source. Spotube keeps
/// matches it has already resolved, so those still arrive here.
var LEGACY_SOURCE = "hifi-api"

/// Routes a track to whichever source can actually play it.
///
/// Sources are tried in the order the published list gives them and the first
/// one with a match wins, so the list is also the preference order: proxies
/// that carry the mainstream catalogue first, the Archive last as the one that
/// cannot be blocked.
class AudioSourceEndpoint {
  var client: HttpClient
  var store: SourceStore

  var hifiApi: HifiApiSource
  var archive: ArchiveOrgSource

  construct (this.client, this.store) {
    hifiApi = HifiApiSource(client)
    archive = ArchiveOrgSource(client)
  }

  fun sourceFor(type) {
    if (type == "hifi-api") return hifiApi
    if (type == "archive") return archive
    // An unknown type in the published list is skipped rather than fatal, so
    // a new source can be listed before every installed plugin understands it.
    return null
  }

  /// Every container any source can deliver.
  ///
  /// Order matters. Spotube selects a preset by index, then keeps only the
  /// streams whose container equals that preset's name and reduces over them,
  /// which throws on an empty list rather than falling back. mp4 stays first
  /// because that is what the hifi-api instances actually return.
  get supportedPresets -> List {
    return [
      {
        type: "lossy",
        name: "mp4",
        qualities: [
          { bitrate: 320000 },
        ],
      }.toJson(),
      {
        type: "lossless",
        name: "flac",
        qualities: [
          { bitDepth: 24, sampleRate: 96000 },
          { bitDepth: 16, sampleRate: 44100 },
        ],
      }.toJson(),
    ]
  }

  /// Collapses the flat source list into one group per type, keeping the
  /// order the list gave: [{ type, bases: [...] }].
  fun grouped(sources: List) -> List {
    var groups = []
    for (var item in sources) {
      var existing = null
      for (var group in groups) {
        if (group["type"] == item["type"]) existing = group
      }
      if (existing == null) {
        groups.add({ "type": item["type"], "bases": [item["base"]] })
      } else {
        existing["bases"].add(item["base"])
      }
    }
    return groups
  }

  /// Reads an artist's name whether it arrives as a map, a struct or a bare
  /// string. `is Map` cannot be used: a Hetu struct is not a Map, so the test
  /// silently fails and the whole object ends up stringified into the query.
  fun artistName(artist) -> String {
    if (artist == null) return ""
    var name = artist["name"]
    if (name != null) return name.toString()
    return artist.toString()
  }

  fun searchText(track: Map) -> String {
    var name = track["name"] ?? ""

    var names = []
    if (track["artists"] != null) {
      for (var artist in track["artists"]) {
        var artistName = artistName(artist)
        if (artistName != "") names.add(artistName)
      }
    }

    if (names.isEmpty) return name
    return "${name} ${names.join(", ")}"
  }

  /// Asks each source in turn and stops at the first with results.
  fun askFrom(index: int, groups: List, track: Map, query: String) -> Future {
    if (index >= groups.length) return Future.value([])

    var group = groups[index]
    var source = sourceFor(group["type"])
    if (source == null) return askFrom(index + 1, groups, track, query)

    return source.matches(track, query, group["bases"]).then((found) {
      if (found != null && found.isNotEmpty) return found
      return askFrom(index + 1, groups, track, query)
    })
  }

  /// Find matching audio sources for a given track. The first match is
  /// considered the best match.
  /// @param track - Map<SpotubeTrackObject>
  /// @returns Future<List<SpotubeAudioSourceMatchObject>>
  fun matches(track: Map) -> List {
    if (track == null) return Future.value([])

    var name = track["name"] ?? ""
    if (name == "") return Future.value([])

    var query = searchText(track)

    return store.resolve().then((sources) {
      return askFrom(0, grouped(sources), track, query)
    })
  }

  /// For the given match, return all available streams.
  /// @param match - Map<SpotubeAudioSourceMatchObject>
  /// @returns Future<List<SpotubeAudioSourceStreamObject>>
  fun streams(match: Map) -> List {
    if (match == null) return Future.value([])

    var id = match["id"]
    if (id == null || id == "") return Future.value([])

    var text = id.toString()
    var cut = text.indexOf(ID_SEPARATOR)

    // No prefix means a match resolved by an older version, which could only
    // have come from hifi-api.
    var type = cut > 0 ? text.substring(0, cut) : LEGACY_SOURCE
    var reference = cut > 0 ? text.substring(cut + 1) : text

    var source = sourceFor(type)
    if (source == null) return Future.value([])

    return store.basesFor(type).then((bases) {
      return source.streams(match, reference, bases)
    })
  }
}

export { AudioSourceEndpoint }
